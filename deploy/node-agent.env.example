# Copy to /etc/vampire-node-agent/agent.env and chmod 0600.
AGENT_LISTEN=0.0.0.0:8081
AGENT_NODE_ID=REPLACE_WITH_PANEL_NODE_ID
AGENT_TOKEN=REPLACE_WITH_ONE_TIME_NODE_TOKEN

AGENT_TLS_CERT=/etc/vampire-node-agent/pki/agent.crt
AGENT_TLS_KEY=/etc/vampire-node-agent/pki/agent.key
AGENT_CLIENT_CA=/etc/vampire-node-agent/pki/panel-client-ca.crt

# Keep false until Docker quota support and firewall rules are verified.
AGENT_ENABLE_JOB_EXECUTION=false
PANEL_API_URL=https://panel.example.com
AGENT_DOCKER_SOCKET=/run/docker.sock
AGENT_DATA_DIR=/var/lib/vampire-dash/agent
AGENT_JOB_POLL_SECONDS=5
AGENT_LEASE_RENEW_SECONDS=20
