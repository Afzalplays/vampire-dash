{
  "name": "vampire-dash",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm run dev --workspace @vampire-dash/api",
    "build": "next build",
    "build:api": "npm run build --workspace @vampire-dash/api",
    "start": "next start",
    "db:generate": "npm run prisma:generate --workspace @vampire-dash/api",
    "db:migrate": "npm run prisma:migrate --workspace @vampire-dash/api",
    "worker:reservations": "npm run worker:reservations --workspace @vampire-dash/api",
    "test:agent-jobs": "npm run test:agent-jobs --workspace @vampire-dash/api"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
