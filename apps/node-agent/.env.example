# HTTPS listener; keep private behind firewall or VPN.
AGENT_LISTEN=127.0.0.1:8081
AGENT_NODE_ID=replace-with-panel-node-id
# Generate a unique random token per node: openssl rand -hex 32
AGENT_TOKEN=replace-with-at-least-32-random-characters
# Server certificate and key signed by your node-agent CA.
AGENT_TLS_CERT=/etc/vampire-node-agent/pki/agent.crt
AGENT_TLS_KEY=/etc/vampire-node-agent/pki/agent.key
# CA that issued the panel API client certificate; required for mTLS.
AGENT_CLIENT_CA=/etc/vampire-node-agent/pki/panel-client-ca.crt
