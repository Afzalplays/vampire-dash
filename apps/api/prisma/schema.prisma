generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum CapacityReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum PlanEntitlementStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ServerOperationType {
  INSTALL_PLUGIN
  INSTALL_MOD
  INSTALL_MODPACK
  CHANGE_VERSION
  RESTART
  STOP
  START
  REINSTALL
  CREATE_BACKUP
  RESTORE_BACKUP
  UPDATE_PROPERTIES
}

enum ServerOperationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  username            String        @unique
  passwordHash        String
  role                UserRole      @default(USER)
  status              AccountStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?
  totpSecretEncrypted String?
  totpEnabled         Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  sessions            Session[]
  servers             MinecraftServer[]
  wallet              Wallet?
  auditEvents         AuditLog[]    @relation("AuditActor")
  emailVerificationCodes EmailVerificationCode[]
  emailNotifications  EmailNotification[]
  notificationPreference NotificationPreference?
  planEntitlements    UserPlanEntitlement[]
  serverOperations    MinecraftServerOperation[]
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model EmailNotification {
  id         String @id @default(cuid())
  userId     String
  recipient  String
  event      String
  subject    String
  bodyText   String
  status     EmailDeliveryStatus @default(PENDING)
  attempts   Int @default(0)
  lastError  String?
  dedupeKey  String? @unique
  createdAt  DateTime @default(now())
  sentAt     DateTime?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
model NotificationPreference {
  id             String @id @default(cuid())
  userId         String @unique
  emailEnabled   Boolean @default(true)
  serverAlerts   Boolean @default(true)
  billingAlerts  Boolean @default(true)
  securityAlerts Boolean @default(true)
  updatedAt      DateTime @updatedAt
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model Wallet {
  id          String         @id @default(cuid())
  userId      String         @unique
  currency    String         @default("INR")
  balancePaise BigInt        @default(0)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger      WalletLedger[]
}
model WalletLedger {
  id          String   @id @default(cuid())
  walletId    String
  amountPaise BigInt
  currency   String   @default("INR")
  kind        String
  reference   String?  @unique
  description String
  createdAt   DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  @@index([walletId, createdAt])
}
model PaymentOrder {
  id              String        @id @default(cuid())
  userId          String
  provider        String
  providerOrderId String?
  amountPaise     BigInt
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([userId, createdAt])
  @@unique([provider, providerOrderId])
}
model Plan {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String   @default("")
  pricePaise         BigInt
  currency           String   @default("INR")
  billingIntervalDays Int
  memoryMb           Int
  diskMb             Int
  cpuPercent         Int
  serverSlots        Int
  enabled            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  entitlements       UserPlanEntitlement[]
  @@index([enabled, pricePaise])
}
model UserPlanEntitlement {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  status    PlanEntitlementStatus @default(ACTIVE)
  startsAt  DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([userId, status, expiresAt])
  @@index([planId, status])
}
model MinecraftNode {
  id             String           @id @default(cuid())
  name           String
  location       String
  endpoint       String
  tokenHash      String           @unique
  tokenCiphertext String?
  tokenNonce     String?
  tokenAuthTag        String?
  enabled             Boolean          @default(false)
  memoryMb            Int
  diskMb              Int
  reservedMemoryMb    Int              @default(0)
  reservedDiskMb      Int              @default(0)
  memoryOverheadMb    Int              @default(1024)
  diskOverheadMb      Int              @default(1024)
  healthStatus        String           @default("UNKNOWN")
  lastSeenAt          DateTime?
  agentVersion        String?
  cpuCores            Int?
  memoryAvailableMb   BigInt?
  diskAvailableMb     BigInt?
  metricsSampledAt    DateTime?
  lastHealthError     String?
  createdAt           DateTime         @default(now())
  servers             MinecraftServer[]
  reservations        NodeCapacityReservation[]
}
model NodeCapacityReservation {
  id             String @id @default(cuid())
  nodeId         String
  memoryMb       Int
  diskMb         Int
  status         CapacityReservationStatus @default(ACTIVE)
  idempotencyKey String @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  node           MinecraftNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  @@index([nodeId, status, expiresAt])
}
model MinecraftServer {
  id         String       @id @default(cuid())
  ownerId    String
  nodeId     String?
  name       String
  software   String
  version    String
  memoryMb   Int
  diskMb     Int
  cpuPercent Int
  status     String       @default("PENDING")
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  node       MinecraftNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  operations MinecraftServerOperation[]
  @@index([ownerId, createdAt])
}

model MinecraftServerOperation {
  id             String @id @default(cuid())
  serverId       String
  actorUserId    String
  type           ServerOperationType
  status         ServerOperationStatus @default(QUEUED)
  idempotencyKey String @unique
  payload        Json
  result         Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  server         MinecraftServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actor          User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([serverId, createdAt])
  @@index([status, createdAt])
}
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetId    String?
  details     String
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([actorUserId, createdAt])
}
