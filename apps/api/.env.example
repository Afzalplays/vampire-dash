NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vampire:change-this-local-password@localhost:5432/vampiredash?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# SMTP is required for email OTP and notification delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=VampireHosting <no-reply@example.com>
# Keep payment provider credentials server-side only.
# FAMGATEWAY_API_KEY=
